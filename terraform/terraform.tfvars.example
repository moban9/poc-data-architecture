# Copy to terraform.tfvars and fill in.
project_id      = "your-gcp-project-id"
name            = "lms-poc"
region          = "us-central1"
zone            = "us-central1-a"
machine_type    = "n2-standard-8"   # or "e2-standard-8" (shared-core)
boot_disk_gb    = 100
allowed_ssh_cidrs = ["203.0.113.0/24"]  # replace with your public IP /32
