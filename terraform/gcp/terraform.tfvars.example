# Copy to terraform.tfvars and fill in.
project_id   = "your-gcp-project-id"
name         = "lms-poc"
region       = "asia-southeast2"
zone         = "asia-southeast2-a"
machine_type = "e2-standard-8"          # 8 vCPU / 32 GB
boot_disk_gb = 100
cert_domain  = "app.example.com"        # create an A record pointing at the LB IP
