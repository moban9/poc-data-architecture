{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "1",
  "topics.regex": "${SINK_TOPICS_REGEX}",
  "iceberg.tables": "${ICEBERG_TABLES}",
  "iceberg.tables.route-field": "_cdc.target",
  "iceberg.table.bronze.loan.route-regex": "bronze\\.loan",
  "iceberg.table.bronze.loan_event.route-regex": "bronze\\.loan_event",
  "iceberg.table.bronze.borrower.route-regex": "bronze\\.borrower",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.evolve-schema-enabled": "true",
  "iceberg.tables.schema-force-optional": "true",
  "iceberg.tables.auto-create-props.format-version": "2",
  "iceberg.tables.auto-create-props.write.format.default": "parquet",
  "iceberg.control.topic": "control-iceberg",
  "iceberg.control.commit.interval-ms": "10000",
  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "${ICEBERG_CATALOG_URI}",
  "iceberg.catalog.warehouse": "${ICEBERG_WAREHOUSE}",
  "iceberg.catalog.credential": "${POLARIS_CREDENTIAL}",
  "iceberg.catalog.scope": "${POLARIS_SCOPE}",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
  "iceberg.catalog.s3.endpoint": "${MINIO_ENDPOINT}",
  "iceberg.catalog.s3.path-style-access": "${MINIO_PATH_STYLE}",
  "iceberg.catalog.s3.region": "${MINIO_REGION}",
  "iceberg.catalog.s3.access-key-id": "${MINIO_ROOT_USER}",
  "iceberg.catalog.s3.secret-access-key": "${MINIO_ROOT_PASSWORD}",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "unwrap",
  "transforms.unwrap.type": "org.apache.iceberg.connect.transforms.DebeziumTransform",
  "transforms.unwrap.cdc.target.pattern": "bronze.{table}"
}
