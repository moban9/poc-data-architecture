# Copy to .env in the compose/ dir. Change every password before any real run.
LMS_DB_USER=lms
LMS_DB_PASSWORD=CHANGE_ME_lms
LMS_DB_NAME=lms

POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=CHANGE_ME_polaris
POLARIS_DB_NAME=polaris

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio

# ── Trino → Polaris → MinIO (Iceberg REST) ───────────────────────────────────
# Used by compose/trino/catalog/lakehouse.properties and compose/polaris/init-lakehouse.sh.
# MINIO_ACCESS_KEY/SECRET are the S3 creds (== MinIO root user for the POC) that
# Polaris vends to Trino. Keep POLARIS_CLIENT_SECRET free of ':' (embedded in the
# Trino oauth2.credential id:secret value).
POLARIS_URI=http://polaris:8181/api/catalog
POLARIS_WAREHOUSE=lakehouse
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=CHANGE_ME_polaris_root
POLARIS_PERSISTENCE_TYPE=relational-jdbc
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio
MINIO_BUCKET=lakehouse

DAGSTER_PG_PASSWORD=CHANGE_ME_dagster
GRAFANA_PASSWORD=CHANGE_ME_grafana

# Component image versions (bump here, not in compose)
POSTGRES_IMAGE=postgres:16
POLARIS_IMAGE=apache/polaris:latest
MINIO_IMAGE=adobe/s3mock:latest
KAFKA_IMAGE=apache/kafka:3.8.1
CONNECT_IMAGE=debezium/connect:2.7.3.Final
TRINO_IMAGE=trinodb/trino:latest
DAGSTER_IMAGE=ghcr.io/dagster-io/dagster:latest
METABASE_IMAGE=metabase/metabase:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
DUCKDB_IMAGE=duckdb/duckdb:latest
TRAEFIK_IMAGE=traefik:v3.2

# Edge layer (Traefik) — base domain for Host-based routing.
DOMAIN=onendo.cloud

# ── CDC connectors ────────────────────────────────────────────────────────
# Used by compose/connectors/register-connectors.sh to render and register the
# Debezium Postgres source + Iceberg sink. All have defaults in the script, so
# these are only needed to override. NOTE: the sink writes to the MinIO bucket
# "warehouse" (ICEBERG_WAREHOUSE) — create it in MinIO before the first run.
CONNECT_URL=http://localhost:8083
# Debezium source (reuses LMS_DB_* above)
LMS_DB_HOST=lms-postgres
LMS_DB_PORT=5432
LMS_TOPIC_PREFIX=lms
DBZ_TABLE_INCLUDE_LIST=public.loan,public.loan_event,public.borrower
DBZ_SLOT_NAME=lms_poc_debezium
DBZ_PUBLICATION_NAME=lms_poc_publication
# Iceberg sink (Polaris REST catalog -> MinIO S3)
ICEBERG_CATALOG_URI=http://polaris:8181/api/catalog
ICEBERG_WAREHOUSE=s3a://warehouse
ICEBERG_TABLES=bronze.loan,bronze.loan_event,bronze.borrower
SINK_TOPICS_REGEX=lms.public.*
MINIO_ENDPOINT=http://minio:9000
MINIO_PATH_STYLE=true
MINIO_REGION=us-east-1
POLARIS_CREDENTIAL=root:root
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
