# Monitoring + Plane incident-ticketing secrets.
#
# Copy to monitoring.env and run:
#     docker compose --env-file monitoring.env -f monitoring.yml up -d
#
# Change EVERY password/secret before any real run. Plane's DB/MQ passwords are
# embedded in connection URLs, so keep them URL-safe (alphanumeric + -_ only).

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana

# ── Plane (required for the ticket-bridge to create incidents) ────────────────
# API endpoint the bridge POSTs issues to (service name `plane` on the shared
# lms-poc network, published to the host on :8010).
PLANE_API_URL=http://plane:8000/api/v1
PLANE_API_KEY=CHANGE_ME_plane_api_key
PLANE_WORKSPACE=CHANGE_ME_workspace_slug
PLANE_PROJECT_ID=CHANGE_ME_project_uuid
# Host-visible UI (for printed ticket links).
PLANE_UI_URL=http://localhost:3010

# ── Plane bootstrap secrets (used by the containers to talk to each other) ────
PLANE_SECRET_KEY=CHANGE_ME_plane_secret_key_at_least_50_chars_long_1234567890
PLANE_DB_USER=plane
PLANE_DB_PASSWORD=CHANGE_ME_plane_db
PLANE_DB_NAME=plane
PLANE_MINIO_ACCESS_KEY=plane
PLANE_MINIO_SECRET_KEY=CHANGE_ME_plane_minio
PLANE_MQ_USER=plane
PLANE_MQ_PASSWORD=CHANGE_ME_plane_mq

# ── Image pins (bump here, not in the compose file) ───────────────────────────
PROMETHEUS_IMAGE=prom/prometheus:latest
ALERTMANAGER_IMAGE=prom/alertmanager:latest
PUSHGATEWAY_IMAGE=prom/pushgateway:latest
GRAFANA_IMAGE=grafana/grafana:latest
TICKET_BRIDGE_IMAGE=python:3.12-slim
PLANE_APP_RELEASE=stable
PLANE_DB_IMAGE=postgres:15.7-alpine
PLANE_REDIS_IMAGE=valkey/valkey:7.2.11-alpine
PLANE_MQ_IMAGE=rabbitmq:3.13.6-management-alpine
PLANE_MINIO_IMAGE=quay.io/minio/minio:latest
